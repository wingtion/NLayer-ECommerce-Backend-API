{
  "ConnectionStrings": {
    "SqlConnection": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=ECommerceDb;Integrated Security=True;TrustServerCertificate=True;"
  },

  "TokenOption": {
    "Audience": [ "www.ecommerce.com" ],
    "Issuer": "www.ecommerce.com",
    "AccessTokenExpiration": 60,
    "RefreshTokenExpiration": 600,
    "SecurityKey": "my_super_secret_security_key_must_be_long_enough_for_security"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
